rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} { allow read, create, update, delete: if isAdmin(); }
    match /students/{studentId} { allow read, create, update, delete: if isAdmin(); }
    match /passClaims/{claimId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }
    match /qrTokens/{token} { allow read, create, update, delete: if isAdmin(); }
    match /checkins/{logId} { allow read, create, update, delete: if isAdmin(); }
  }
}
